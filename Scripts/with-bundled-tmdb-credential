#!/usr/bin/env bash

set -euo pipefail
set +x

project_directory="$(cd "$(dirname "$0")/.." && pwd)"
generated_source="$project_directory/Sources/CallupTMDB/BundledTMDBCredential.generated.swift"

if [[ -f "$project_directory/.env" ]]; then
    set -a
    source "$project_directory/.env"
    set +a
fi

if [[ -z "${CALLUP_TMDB_ACCESS_TOKEN:-}" ]]; then
    echo "CALLUP_TMDB_ACCESS_TOKEN is required to build an official Callup binary." >&2
    exit 1
fi

cleanup() {
    rm -f "$generated_source"
}
trap cleanup EXIT HUP INT TERM

umask 077
encoded_token="$(printf '%s' "$CALLUP_TMDB_ACCESS_TOKEN" | base64 | tr -d '\n')"
printf '%s\n' \
    'import Foundation' \
    '' \
    'public enum BundledTMDBCredential {' \
    "    private static let encodedAccessToken = \"$encoded_token\"" \
    '' \
    '    public static let accessToken: String? = Data(base64Encoded: encodedAccessToken)' \
    '        .flatMap { String(data: $0, encoding: .utf8) }' \
    '}' > "$generated_source"

cd "$project_directory"
"$@"
