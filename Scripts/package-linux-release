#!/bin/sh
set -eu

version=${1:?Usage: Scripts/package-linux-release VERSION}
binary=.build/x86_64-swift-linux-musl/release/callup
release_dir="dist/callup-${version}-linux-amd64"
archive="dist/callup-${version}-linux-amd64.tar.gz"

test -x "$binary" || { echo "Missing static Linux artifact: $binary" >&2; exit 1; }

case "$(file "$binary")" in
  *"ELF 64-bit LSB executable, x86-64"*"statically linked"*) ;;
  *) echo "Refusing to package a binary that is not static Linux x86_64: $binary" >&2; exit 1 ;;
esac

if find Package.swift Sources -type f -newer "$binary" -print -quit | grep -q .; then
  echo "Refusing to package a stale binary; rebuild the public Linux release first." >&2
  exit 1
fi

rm -rf "$release_dir"
mkdir -p "$release_dir"
install -m 0755 "$binary" "$release_dir/callup"
install -m 0755 deploy/install.sh "$release_dir/install.sh"
install -m 0644 deploy/callup.service "$release_dir/callup.service"
install -m 0644 deploy/callup.env "$release_dir/callup.env"
tar -C dist -czf "$archive" "$(basename "$release_dir")"
(cd dist && shasum -a 256 "$(basename "$archive")") > "${archive}.sha256"
echo "$archive"
