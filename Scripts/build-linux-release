#!/usr/bin/env bash

set -euo pipefail

project_directory="$(cd "$(dirname "$0")/.." && pwd)"
sdk="${CALLUP_SWIFT_SDK:-x86_64-swift-linux-musl}"

if ! command -v swiftly >/dev/null 2>&1; then
    echo "swiftly is required so the static SDK uses the matching open-source Swift toolchain." >&2
    exit 1
fi

"$project_directory/Scripts/with-bundled-tmdb-credential" \
    swiftly run swift build \
    -c release \
    --swift-sdk "$sdk" \
    --product callup
