#!/usr/bin/env bash

set -euo pipefail

project_directory="$(cd "$(dirname "$0")/.." && pwd)"
cd "$project_directory"

"$project_directory/Scripts/with-bundled-tmdb-credential" /usr/bin/swift build -c release

branch="$(git branch --show-current)"
revision="$(git rev-parse --short HEAD)"
if [[ -n "$(git status --porcelain)" ]]; then
    revision="${revision}-dirty"
fi

printf '%s@%s\n' "$branch" "$revision" > .build/canonical-revision
